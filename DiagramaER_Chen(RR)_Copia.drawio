  <diagram name="Página-1" id="wuP9HBEMJX1EAQoQV-Il">
    <mxGraphModel dx="393" dy="11210" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% =========================================================\n%%  DIAGRAMA CHEN (E-R) COMPLETO — con TODAS las tablas y atributos\n%%  Colores: entidades (azul), relaciones (beige), atributos (verde),\n%%           ISA (rosado), atributos de relación (rosado claro)\n%% =========================================================\n\n%% =========================\n%% (A) USUARIOS + ISA (d,t)\n%% =========================\nsubgraph G_USUARIOS[\&quot;\&quot;]\ndirection TB\n\nU[USUARIOS]\nISA((ISA&lt;br/&gt;(d,t)))\nCLI[CLIENTES]\nINS[INSTRUCTORES]\nADM[ADMINISTRADORES]\n\nU --- ISA\nISA --- CLI\nISA --- INS\nISA --- ADM\n\n%% --- Atributos USUARIOS\nU_numid([\&quot;varchar(20) numero_identificacion PK\&quot;])\nU_tipoid([\&quot;varchar(10) tipo_identificacion\&quot;])\nU_nombre([\&quot;varchar(200) nombre\&quot;])\nU_apellidos([\&quot;varchar(200) apellidos\&quot;])\nU_tel([\&quot;varchar(20) telefono\&quot;])\nU_correo([\&quot;varchar(150) correo\&quot;])\nU_pass([\&quot;varchar(255) contrasena_hash\&quot;])\nU_foto([\&quot;varchar(500) foto_url\&quot;])\nU_estado([\&quot;varchar(20) estado\&quot;])\nU_freg([\&quot;date fecha_registro\&quot;])\nU_tuser([\&quot;varchar(20) tipo_usuario\&quot;])\n\nU --- U_numid\nU --- U_tipoid\nU --- U_nombre\nU --- U_apellidos\nU --- U_tel\nU --- U_correo\nU --- U_pass\nU --- U_foto\nU --- U_estado\nU --- U_freg\nU --- U_tuser\n\n%% --- Atributos CLIENTES\nC_numid([\&quot;varchar(20) numero_identificacion PK,FK\&quot;])\nC_dir([\&quot;varchar(300) direccion\&quot;])\nC_fnac([\&quot;date fecha_nacimiento\&quot;])\nC_huella([\&quot;bytea huella_dactilar\&quot;])\n\nCLI --- C_numid\nCLI --- C_dir\nCLI --- C_fnac\nCLI --- C_huella\n\n%% --- Atributos INSTRUCTORES\nI_numid([\&quot;varchar(20) numero_identificacion PK,FK\&quot;])\nI_idesp([\&quot;bigint id_especialidad FK\&quot;])\nI_disp([\&quot;varchar(200) disponibilidad\&quot;])\nI_fcont([\&quot;date fecha_contratacion\&quot;])\n\nINS --- I_numid\nINS --- I_idesp\nINS --- I_disp\nINS --- I_fcont\n\n%% --- Atributos ADMINISTRADORES\nA_numid([\&quot;varchar(20) numero_identificacion PK,FK\&quot;])\nA_rol([\&quot;varchar(30) rol\&quot;])\n\nADM --- A_numid\nADM --- A_rol\n\nend\nstyle G_USUARIOS fill:transparent,stroke:transparent\n\n%% =========================\n%% (B) CATÁLOGOS\n%% =========================\nsubgraph G_CATALOGOS[\&quot;\&quot;]\ndirection TB\n\nESP[ESPECIALIDADES]\nPLAN[PLANES_MEMBRESIAS]\n\n%% ESPECIALIDADES\nESP_id([\&quot;bigint id_especialidad PK\&quot;])\nESP_nom([\&quot;varchar(100) nombre\&quot;])\nESP --- ESP_id\nESP --- ESP_nom\n\n%% PLANES_MEMBRESIAS\nPLAN_id([\&quot;bigint id_plan PK\&quot;])\nPLAN_nom([\&quot;varchar(100) nombre\&quot;])\nPLAN_desc([\&quot;varchar(500) descripcion\&quot;])\nPLAN_pm([\&quot;numeric(10,2) precio_mensual\&quot;])\nPLAN_ps([\&quot;numeric(10,2) precio_semestral\&quot;])\nPLAN_pa([\&quot;numeric(10,2) precio_anual\&quot;])\nPLAN_ben([\&quot;text beneficios\&quot;])\n\nPLAN --- PLAN_id\nPLAN --- PLAN_nom\nPLAN --- PLAN_desc\nPLAN --- PLAN_pm\nPLAN --- PLAN_ps\nPLAN --- PLAN_pa\nPLAN --- PLAN_ben\n\nend\nstyle G_CATALOGOS fill:transparent,stroke:transparent\n\n%% =========================\n%% (C) MEMBRESÍAS / HISTORIAL / PAGOS\n%% =========================\nsubgraph G_MEM[\&quot;\&quot;]\ndirection TB\n\nMEM[MEMBRESIAS]\nHIS[HISTORIAL_MEMBRESIAS]\nPAG[PAGOS]\n\n%% MEMBRESIAS\nMEM_id([\&quot;bigint id_membresia PK\&quot;])\nMEM_plan([\&quot;bigint id_plan FK\&quot;])\nMEM_tipo([\&quot;varchar(50) tipo_membresia\&quot;])\nMEM_mod([\&quot;varchar(20) modalidad_pago\&quot;])\nMEM_val([\&quot;numeric(10,2) valor\&quot;])\nMEM_fini([\&quot;date fecha_inicio\&quot;])\nMEM_fven([\&quot;date fecha_vencimiento\&quot;])\nMEM_est([\&quot;varchar(20) estado\&quot;])\n\nMEM --- MEM_id\nMEM --- MEM_plan\nMEM --- MEM_tipo\nMEM --- MEM_mod\nMEM --- MEM_val\nMEM --- MEM_fini\nMEM --- MEM_fven\nMEM --- MEM_est\n\n%% HISTORIAL_MEMBRESIAS\nHIS_id([\&quot;bigint id_historial PK\&quot;])\nHIS_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nHIS_mem([\&quot;bigint id_membresia FK\&quot;])\nHIS_fas([\&quot;date fecha_asignacion\&quot;])\nHIS_ffin([\&quot;date fecha_fin\&quot;])\nHIS_act([\&quot;smallint activa\&quot;])\n\nHIS --- HIS_id\nHIS --- HIS_cli\nHIS --- HIS_mem\nHIS --- HIS_fas\nHIS --- HIS_ffin\nHIS --- HIS_act\n\n%% PAGOS\nPAG_id([\&quot;bigint id_pago PK\&quot;])\nPAG_mem([\&quot;bigint id_membresia FK\&quot;])\nPAG_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nPAG_f([\&quot;date fecha_pago\&quot;])\nPAG_val([\&quot;numeric(10,2) valor\&quot;])\nPAG_met([\&quot;varchar(30) metodo_pago\&quot;])\nPAG_est([\&quot;varchar(20) estado_pago\&quot;])\nPAG_ref([\&quot;varchar(100) referencia_transaccion\&quot;])\nPAG_obs([\&quot;varchar(500) observaciones\&quot;])\n\nPAG --- PAG_id\nPAG --- PAG_mem\nPAG --- PAG_cli\nPAG --- PAG_f\nPAG --- PAG_val\nPAG --- PAG_met\nPAG --- PAG_est\nPAG --- PAG_ref\nPAG --- PAG_obs\n\nend\nstyle G_MEM fill:transparent,stroke:transparent\n\n%% =========================\n%% (D) ENTRENAMIENTO: RUTINAS / EJERCICIOS / RELACIÓN CON ATRIBUTOS\n%% =========================\nsubgraph G_TRAIN[\&quot;\&quot;]\ndirection TB\n\nRUT[RUTINAS]\nEJ[EJERCICIOS]\n\n%% RUTINAS\nRUT_id([\&quot;bigint id_rutina PK\&quot;])\nRUT_ins([\&quot;varchar(20) id_instructor FK\&quot;])\nRUT_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nRUT_nom([\&quot;varchar(150) nombre\&quot;])\nRUT_desc([\&quot;text descripcion\&quot;])\nRUT_fc([\&quot;date fecha_creacion\&quot;])\nRUT_ff([\&quot;date fecha_fin\&quot;])\nRUT_dias([\&quot;varchar(100) dias_semana\&quot;])\nRUT_obj([\&quot;varchar(200) objetivo\&quot;])\n\nRUT --- RUT_id\nRUT --- RUT_ins\nRUT --- RUT_cli\nRUT --- RUT_nom\nRUT --- RUT_desc\nRUT --- RUT_fc\nRUT --- RUT_ff\nRUT --- RUT_dias\nRUT --- RUT_obj\n\n%% EJERCICIOS\nEJ_id([\&quot;bigint id_ejercicio PK\&quot;])\nEJ_nom([\&quot;varchar(150) nombre\&quot;])\nEJ_desc([\&quot;text descripcion\&quot;])\nEJ_gm([\&quot;varchar(100) grupo_muscular\&quot;])\nEJ_ser([\&quot;smallint series\&quot;])\nEJ_rep([\&quot;smallint repeticiones\&quot;])\nEJ_dur([\&quot;smallint duracion_minutos\&quot;])\nEJ_niv([\&quot;varchar(20) nivel\&quot;])\nEJ_url([\&quot;varchar(500) recurso_url\&quot;])\n\nEJ --- EJ_id\nEJ --- EJ_nom\nEJ --- EJ_desc\nEJ --- EJ_gm\nEJ --- EJ_ser\nEJ --- EJ_rep\nEJ --- EJ_dur\nEJ --- EJ_niv\nEJ --- EJ_url\n\nend\nstyle G_TRAIN fill:transparent,stroke:transparent\n\n%% =========================\n%% (E) OPERACIÓN: PROGRESOS, INGRESOS, CITAS, CHAT, NOTIFICACIONES\n%% =========================\nsubgraph G_OPS[\&quot;\&quot;]\ndirection TB\n\nPRO[PROGRESOS]\nING[REGISTROS_INGRESOS]\nCIT[CITAS]\nSES[SESIONES_GYMBROT]\nMSG[MENSAJES_GYMBROT]\nPLA[PLANTILLAS_MENSAJE]\nNOTI[NOTIFICACIONES]\n\n%% PROGRESOS\nPRO_id([\&quot;bigint id_progreso PK\&quot;])\nPRO_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nPRO_f([\&quot;date fecha_registro\&quot;])\nPRO_p([\&quot;numeric(6,2) peso\&quot;])\nPRO_a([\&quot;numeric(5,2) altura\&quot;])\nPRO_imc([\&quot;numeric(5,2) imc\&quot;])\nPRO_pg([\&quot;numeric(5,2) porcentaje_grasa\&quot;])\nPRO_mm([\&quot;numeric(6,2) masa_muscular\&quot;])\nPRO_obj([\&quot;varchar(200) objetivo\&quot;])\nPRO_obs([\&quot;text observaciones\&quot;])\n\nPRO --- PRO_id\nPRO --- PRO_cli\nPRO --- PRO_f\nPRO --- PRO_p\nPRO --- PRO_a\nPRO --- PRO_imc\nPRO --- PRO_pg\nPRO --- PRO_mm\nPRO --- PRO_obj\nPRO --- PRO_obs\n\n%% REGISTROS_INGRESOS\nING_id([\&quot;bigint id_ingreso PK\&quot;])\nING_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nING_f([\&quot;date fecha\&quot;])\nING_he([\&quot;timestamp hora_entrada\&quot;])\nING_hs([\&quot;timestamp hora_salida\&quot;])\nING_mv([\&quot;varchar(20) metodo_verificacion\&quot;])\nING_ev([\&quot;varchar(20) estado_verificacion\&quot;])\n\nING --- ING_id\nING --- ING_cli\nING --- ING_f\nING --- ING_he\nING --- ING_hs\nING --- ING_mv\nING --- ING_ev\n\n%% CITAS\nCIT_id([\&quot;bigint id_cita PK\&quot;])\nCIT_ins([\&quot;varchar(20) id_instructor FK\&quot;])\nCIT_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nCIT_f([\&quot;date fecha\&quot;])\nCIT_h([\&quot;timestamp hora\&quot;])\nCIT_tipo([\&quot;varchar(30) tipo_cita\&quot;])\nCIT_est([\&quot;varchar(20) estado\&quot;])\nCIT_notas([\&quot;text notas\&quot;])\n\nCIT --- CIT_id\nCIT --- CIT_ins\nCIT --- CIT_cli\nCIT --- CIT_f\nCIT --- CIT_h\nCIT --- CIT_tipo\nCIT --- CIT_est\nCIT --- CIT_notas\n\n%% SESIONES_GYMBROT\nSES_id([\&quot;bigint id_sesion PK\&quot;])\nSES_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nSES_f([\&quot;date fecha\&quot;])\nSES_hi([\&quot;timestamp hora_inicio\&quot;])\nSES_hf([\&quot;timestamp hora_fin\&quot;])\nSES_ctx([\&quot;text contexto_activo\&quot;])\n\nSES --- SES_id\nSES --- SES_cli\nSES --- SES_f\nSES --- SES_hi\nSES --- SES_hf\nSES --- SES_ctx\n\n%% MENSAJES_GYMBROT\nMSG_id([\&quot;bigint id_mensaje PK\&quot;])\nMSG_ses([\&quot;bigint id_sesion FK\&quot;])\nMSG_cit([\&quot;bigint id_cita FK\&quot;])\nMSG_rem([\&quot;varchar(10) remitente\&quot;])\nMSG_con([\&quot;text contenido\&quot;])\nMSG_ts([\&quot;timestamp timestamp_msg\&quot;])\nMSG_int([\&quot;varchar(30) tipo_intencion\&quot;])\n\nMSG --- MSG_id\nMSG --- MSG_ses\nMSG --- MSG_cit\nMSG --- MSG_rem\nMSG --- MSG_con\nMSG --- MSG_ts\nMSG --- MSG_int\n\n%% PLANTILLAS_MENSAJE\nPLA_id([\&quot;bigint id_plantilla PK\&quot;])\nPLA_nom([\&quot;varchar(100) nombre\&quot;])\nPLA_tipo([\&quot;varchar(20) tipo\&quot;])\nPLA_asu([\&quot;varchar(200) asunto\&quot;])\nPLA_html([\&quot;text cuerpo_html\&quot;])\nPLA_txt([\&quot;text cuerpo_texto\&quot;])\nPLA_vars([\&quot;varchar(500) variables_disponibles\&quot;])\nPLA_act([\&quot;smallint activa\&quot;])\n\nPLA --- PLA_id\nPLA --- PLA_nom\nPLA --- PLA_tipo\nPLA --- PLA_asu\nPLA --- PLA_html\nPLA --- PLA_txt\nPLA --- PLA_vars\nPLA --- PLA_act\n\n%% NOTIFICACIONES\nNOTI_id([\&quot;bigint id_notificacion PK\&quot;])\nNOTI_cli([\&quot;varchar(20) id_cliente FK\&quot;])\nNOTI_pla([\&quot;bigint id_plantilla FK\&quot;])\nNOTI_tipo([\&quot;varchar(20) tipo\&quot;])\nNOTI_asu([\&quot;varchar(200) asunto\&quot;])\nNOTI_con([\&quot;text contenido\&quot;])\nNOTI_est([\&quot;varchar(20) estado_envio\&quot;])\nNOTI_f([\&quot;timestamp fecha_envio\&quot;])\nNOTI_ori([\&quot;varchar(20) origen\&quot;])\n\nNOTI --- NOTI_id\nNOTI --- NOTI_cli\nNOTI --- NOTI_pla\nNOTI --- NOTI_tipo\nNOTI --- NOTI_asu\nNOTI --- NOTI_con\nNOTI --- NOTI_est\nNOTI --- NOTI_f\nNOTI --- NOTI_ori\n\nend\nstyle G_OPS fill:transparent,stroke:transparent\n\n%% =========================================================\n%% RELACIONES CHEN (rombos) + cardinalidades (min..max)\n%% =========================================================\n\nR_EJERCE{ejerce en}\nINS ---|\&quot;1..1\&quot;| R_EJERCE ---|\&quot;0..N\&quot;| ESP\n\nR_CONTRATA{se contrata como}\nMEM ---|\&quot;1..1\&quot;| R_CONTRATA ---|\&quot;0..N\&quot;| PLAN\n\nR_TIENE_HIST{tiene historial de}\nCLI ---|\&quot;1..N\&quot;| R_TIENE_HIST ---|\&quot;1..1\&quot;| HIS\n\nR_REG_HIS{es registrada en}\nMEM ---|\&quot;1..N\&quot;| R_REG_HIS ---|\&quot;1..1\&quot;| HIS\n\nR_REALIZA{realiza}\nCLI ---|\&quot;0..N\&quot;| R_REALIZA ---|\&quot;1..1\&quot;| PAG\n\nR_PAGADA{es pagada en}\nMEM ---|\&quot;0..N\&quot;| R_PAGADA ---|\&quot;1..1\&quot;| PAG\n\nR_REG_PRO{registra}\nCLI ---|\&quot;0..N\&quot;| R_REG_PRO ---|\&quot;1..1\&quot;| PRO\n\nR_GEN_ING{genera}\nCLI ---|\&quot;0..N\&quot;| R_GEN_ING ---|\&quot;1..1\&quot;| ING\n\nR_DISENA{diseña}\nINS ---|\&quot;0..N\&quot;| R_DISENA ---|\&quot;1..1\&quot;| RUT\n\nR_RECIBE_RUT{recibe}\nCLI ---|\&quot;0..N\&quot;| R_RECIBE_RUT ---|\&quot;1..1\&quot;| RUT\n\n%% Relación M:N con atributos (implementa tabla RUTINA_EJERCICIOS)\nR_INCLUYE{incluye&lt;br/&gt;(RUTINA_EJERCICIOS)}\nRUT ---|\&quot;1..N\&quot;| R_INCLUYE ---|\&quot;0..N\&quot;| EJ\n\nRE_orden([\&quot;smallint orden\&quot;])\nRE_dia([\&quot;varchar(15) dia_semana\&quot;])\nRE_notas([\&quot;text notas_instructor\&quot;])\nR_INCLUYE --- RE_orden\nR_INCLUYE --- RE_dia\nR_INCLUYE --- RE_notas\n\nR_ATIENDE{atiende}\nINS ---|\&quot;0..N\&quot;| R_ATIENDE ---|\&quot;1..1\&quot;| CIT\n\nR_AGENDA{agenda}\nCLI ---|\&quot;0..N\&quot;| R_AGENDA ---|\&quot;1..1\&quot;| CIT\n\nR_CHATEA{chatea en}\nCLI ---|\&quot;0..N\&quot;| R_CHATEA ---|\&quot;1..1\&quot;| SES\n\nR_CONTIENE{contiene}\nSES ---|\&quot;1..N\&quot;| R_CONTIENE ---|\&quot;1..1\&quot;| MSG\n\nR_REF{es referenciada en}\nCIT ---|\&quot;0..N\&quot;| R_REF ---|\&quot;0..1\&quot;| MSG\n\nR_REC_NOTI{recibe}\nCLI ---|\&quot;0..N\&quot;| R_REC_NOTI ---|\&quot;1..1\&quot;| NOTI\n\nR_ORIGEN{es origen de}\nPLA ---|\&quot;0..N\&quot;| R_ORIGEN ---|\&quot;1..1\&quot;| NOTI\n\n%% =========================================================\n%% COLORES (conservados)\n%% =========================================================\nclassDef entidad fill:#cfe8ff,stroke:#2b6cb0,stroke-width:2px,color:#0b2545;\nclassDef relacion fill:#f3d3a0,stroke:#b7791f,stroke-width:2px,color:#3b2f0b;\nclassDef atributo fill:#d9f7c5,stroke:#2f855a,stroke-width:1.5px,color:#1c4532;\nclassDef isa fill:#f7c6d0,stroke:#b83280,stroke-width:2px,color:#521b41;\nclassDef attrRel fill:#fbd5e5,stroke:#b83280,stroke-width:1.5px,color:#521b41;\n\nclass U,CLI,INS,ADM,ESP,PLAN,MEM,HIS,PAG,RUT,EJ,PRO,ING,CIT,SES,MSG,PLA,NOTI entidad;\nclass R_EJERCE,R_CONTRATA,R_TIENE_HIST,R_REG_HIS,R_REALIZA,R_PAGADA,R_REG_PRO,R_GEN_ING,R_DISENA,R_RECIBE_RUT,R_INCLUYE,R_ATIENDE,R_AGENDA,R_CHATEA,R_CONTIENE,R_REF,R_REC_NOTI,R_ORIGEN relacion;\nclass ISA isa;\n\nclass U_numid,U_tipoid,U_nombre,U_apellidos,U_tel,U_correo,U_pass,U_foto,U_estado,U_freg,U_tuser atributo;\nclass C_numid,C_dir,C_fnac,C_huella atributo;\nclass I_numid,I_idesp,I_disp,I_fcont atributo;\nclass A_numid,A_rol atributo;\n\nclass ESP_id,ESP_nom atributo;\n\nclass PLAN_id,PLAN_nom,PLAN_desc,PLAN_pm,PLAN_ps,PLAN_pa,PLAN_ben atributo;\n\nclass MEM_id,MEM_plan,MEM_tipo,MEM_mod,MEM_val,MEM_fini,MEM_fven,MEM_est atributo;\n\nclass HIS_id,HIS_cli,HIS_mem,HIS_fas,HIS_ffin,HIS_act atributo;\n\nclass PAG_id,PAG_mem,PAG_cli,PAG_f,PAG_val,PAG_met,PAG_est,PAG_ref,PAG_obs atributo;\n\nclass RUT_id,RUT_ins,RUT_cli,RUT_nom,RUT_desc,RUT_fc,RUT_ff,RUT_dias,RUT_obj atributo;\n\nclass EJ_id,EJ_nom,EJ_desc,EJ_gm,EJ_ser,EJ_rep,EJ_dur,EJ_niv,EJ_url atributo;\n\nclass PRO_id,PRO_cli,PRO_f,PRO_p,PRO_a,PRO_imc,PRO_pg,PRO_mm,PRO_obj,PRO_obs atributo;\n\nclass ING_id,ING_cli,ING_f,ING_he,ING_hs,ING_mv,ING_ev atributo;\n\nclass CIT_id,CIT_ins,CIT_cli,CIT_f,CIT_h,CIT_tipo,CIT_est,CIT_notas atributo;\n\nclass SES_id,SES_cli,SES_f,SES_hi,SES_hf,SES_ctx atributo;\n\nclass MSG_id,MSG_ses,MSG_cit,MSG_rem,MSG_con,MSG_ts,MSG_int atributo;\n\nclass PLA_id,PLA_nom,PLA_tipo,PLA_asu,PLA_html,PLA_txt,PLA_vars,PLA_act atributo;\n\nclass NOTI_id,NOTI_cli,NOTI_pla,NOTI_tipo,NOTI_asu,NOTI_con,NOTI_est,NOTI_f,NOTI_ori atributo;\n\nclass RE_orden,RE_dia,RE_notas attrRel;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rUPkwWeTBifBiNuvTkDQ-122">

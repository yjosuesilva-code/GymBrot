# [web-api] Copia este archivo como .env.development.local (no se sube a git)
# y deja la linea de abajo para que Clientes use la Web API de ASP.NET Core
# (backend/GymBrot.Api, perfil "http" en Visual Studio).
# Sin esta variable, la app sigue guardando en localStorage como antes.
VITE_API_URL=http://localhost:5107/api
